# Copy to .env and set strong random values. Never commit real credentials.
COOKIE_SECURE=0
APP_SECRET=replace-with-a-long-random-session-secret
TOKEN_ENCRYPTION_KEY=generate-with-python-c-from-cryptography-fernet
DATABASE_PATH=dashboard.sqlite3
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=http://localhost:5000/oauth/callback
EBAY_RUNAME=
EBAY_ENV=production
# Optional, for UK/EU seller Finances API calls:
EBAY_SIGNING_KEY_JWE=
EBAY_SIGNING_PRIVATE_KEY_PEM=
EBAY_SIGNING_KEY_ID=
