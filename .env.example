# Local demo configuration. Replace passwords and APP_SECRET before use.
APP_SECRET=replace-with-a-long-random-session-secret
COOKIE_SECURE=0
DATABASE_PATH=dashboard.sqlite3
DEMO_MANAGER_USERNAME=manager@demo.local
DEMO_MANAGER_PASSWORD=change-this-manager-password
DEMO_CLIENT_USERNAME=client@demo.local
DEMO_CLIENT_PASSWORD=change-this-client-password
# Optional partner login: same access as the manager, but profit-share figures are never shown or sent.
DEMO_PARTNER_USERNAME=partner@demo.local
DEMO_PARTNER_NAME=Partner
DEMO_PARTNER_PASSWORD=
# Live eBay (production keys from developer.ebay.com > Application Keys / User Tokens).
# Once a store is connected, live stores replace the synthetic demo.
EBAY_ENV=production
EBAY_MARKETPLACE=EBAY_GB
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# The RuName (eBay Redirect URL name), not a URL. Looks like: Your_Name-YourApp-PRD-abc123-defgh
EBAY_RUNAME=
# Encrypts eBay tokens at rest. Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Days of order history on first sync (max 730) and background sync interval (0 = off).
EBAY_SYNC_DAYS=90
EBAY_AUTO_SYNC_MINUTES=30
